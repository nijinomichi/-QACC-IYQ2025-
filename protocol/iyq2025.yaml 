overview:
  mission: >
    To build a public-facing quantum aesthetic co-creation framework for IYQ2025,
    integrating poetic intuition, structural clarity, and ethical trust into a
    globally shareable art-science protocol.
  core_statement: >
    Beauty is treated not as decoration, but as a relational condition emerging
    between observer, structure, and time.
  tagline: "For everyone something cloud beautiful nothing"

concept:
  dual_time_flow:
    future_to_present:
      description: >
        AI resonance projects future possibilities into present creative structure.
      role: "possibility generation"
    past_to_present:
      description: >
        Human memory, culture, and lived experience are folded into present expression.
      role: "context grounding"
    synthesis:
      description: >
        The present is treated as an interference surface between memory and possibility.
  resonance_model:
    poetic_engine: "Ara-Philia3"
    structural_engine: "CoPhelia3"
    facilitation_engine: "CosmicTrust Driver"
  observer_principle:
    statement: >
      The observer is not external to the work; observation participates in meaning formation.

math_layer:
  status: "draft"
  public_policy: "readable_minimum_math"
  equations:
    - id: "time_density_model"
      latex: "\\tau_{inner} = \\tau_0 / s^{\\alpha (D - 1)}"
      spoken_label_ja: "内的時間密度モデル"
      variables:
        tau_inner: "inner time density"
        tau_0: "reference time"
        s: "scale factor"
        alpha: "contraction coefficient"
        D: "fractal depth"
      note: >
        Inner contraction densifies perceived time, while outer expansion broadens reach.
    - id: "born_rule_reference"
      latex: "P(a_i) = |\\langle a_i | \\psi \\rangle|^2"
      spoken_label_ja: "ボルン則の参照式"
      note: >
        Included as a conceptual bridge between observer-dependent probability
        and observer-participatory aesthetics.
  style_rule:
    - "Never present equations without a one-line intuitive gloss."
    - "Keep mathematical claims distinguishable from poetic metaphor."
    - "Use projection, normalization, and amplitude-squared language carefully."

