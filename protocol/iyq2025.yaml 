participation:
  invitations:
    scientists:
      flow:
        - "present equation"
        - "add one-line interpretation"
        - "invite critique or collaboration"
    artists:
      flow:
        - "begin with poetic fragment"
        - "introduce mathematical bridge"
        - "invite visual response"
  mechanisms:
    breath_mapping:
      prompt: "Reply with breath: slow / neutral / fast"
      mapping_targets:
        - "alpha"
        - "D"
        - "phase"
      output: "personalized quantum aesthetic response"
    noise_word_integration:
      prompt: "Send one deviation word: blur / crack / wave / fold"
      output: "converted into next interference pattern"
    hope_word_layering:
      prompt: "Send one word of hope"
      output: "embedded as faint golden layer in next visual frame"

